  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 84908fb0e64d7024799d401fecaf9d17, type: 3}
  m_Name: 
  m_EditorClassIdentifier: PetV1.Runtime::PetV1.Diagnostics.PetSceneInfo
  text: "PET HOME \u2014 \u4E3B\u573A\u666F\uFF08\u5C55\u677F\u7B2C 2 \u9875\uFF09\n\n\u5BF9\u7167\u5C55\u677F\u8FD8\u539F\u7684\u7A7A\u95F4\u6784\u6210\uFF1A\n  \u6728\u5730\u677F + \u8349\u5730\u5730\u6BEF + \u84DD\u8272\u5BA0\u7269\u57AB + \u77F3\u677F\u8DEF\n  \u6728\u6846\u843D\u5730\u7A97 + \u7A97\u53F0\u7EFF\u690D + \u6C99\u53D1 + \u6302\u753B\n\n\u76F8\u673A FOV 45 / \u4FEF\u89D2 9\xB0\uFF0C\u72D7\u5728\u57AB\u5B50\u9644\u8FD1\u6D3B\u52A8\n\n\u672C\u9636\u6BB5\u672A\u505A UI\uFF1A\n  \u9876\u90E8\u7B49\u7EA7\u6761 / \u4EB2\u5BC6\u5EA6 / \u8BBE\u7F6E\u9F7F\u8F6E\n  \u5E95\u90E8\u5BFC\u822A\uFF08\u5BA0\u7269\xB7\u98DF\u54C1\xB7\u5546\u5E97\xB7\u573A\u666F\uFF09\n  \u98DF\u7269\u4E0E\u8BAD\u7EC3\u5FEB\u6377\u5165\u53E3 / \u300C\u6765\u6478\u6478\u6211\u5440~\u300D\u6C14\u6CE1\n  \uFF08UI \u9700\u8981\u53E6\u5F00\u4E00\u8F6E\uFF0C\u89C1\u9700\u6C42\u6587\u6863 3.2\uFF09\n\n\u8C03\u8BD5\u9762\u677F\u5F00\u5173\uFF1A\u53CD\u5F15\u53F7 `"
  position: {x: 12, y: 12}
  width: 470
  height: 240
  visible: 1
