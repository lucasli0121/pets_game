# 复制为 .env 后修改。环境变量优先于本文件。

# ---- HTTP ----
ADDR=:8080
DEBUG=true

# ---- MongoDB ----
# 已按当前环境预填；生产请换独立账号，不要用 admin
MONGO_URI=mongodb://<user>:<password>@localhost:27017/?authSource=admin
MONGO_DB=pets_game

# ---- 鉴权 ----
# 上线前必须改成随机长串，否则任何人都能伪造 token
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_TOKEN_TTL_HOURS=720
ADMIN_TOKEN_TTL_HOURS=12

# ---- 微信小游戏 ----
# 留空 + ALLOW_DEV_LOGIN=true 时可用 devOpenid 联调；上线必须填并关闭 dev 登录
WX_APPID=
WX_SECRET=
ALLOW_DEV_LOGIN=true

# ---- 频控（文档 6.6：同一接口 10 秒内超过 10 次拒绝）----
RATE_LIMIT_WINDOW_SEC=10
RATE_LIMIT_MAX_CALLS=10

# ---- 管理端初始账号（仅在 admin_users 为空时创建）----
# 单管理员模型：只有 admin 一个账号，不提供多账号与改密页面。
# 本地联调可填 admin，**上线必须覆盖成强口令**。
# 改密方式：改这里 → 清空 admin_users 集合 → 重启（会按新值重新种子）。
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=<strong-password>

# ---- 静态资源 ----
# CDN 根地址。场景配置的「缩略图路径」「场景图路径」是相对这里的路径，
# 服务端下发时拼成完整 URL（thumbUrl / sceneUrl）。
# 留空则相对路径原样下发，客户端只能按 sceneKey 走包内资源。
# 必须是已 ICP 备案的 https 域名。
ASSET_BASE_URL=

# ---- 配置发布 ----
CONFIG_RELEASE_KEEP=10

# ---- 管理端静态资源目录（留空则使用二进制内置版本）----
ADMIN_DIR=internal/web/admin
